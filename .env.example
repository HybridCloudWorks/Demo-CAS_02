# Copy to .env (git-ignored) and `source .env` on the workstation. Placeholders only. Never commit real values.
# ---- Azure (identity: az login; no secrets) ----
export AZURE_TENANT_ID="<AZURE_TENANT_ID>"
export AZURE_SUBSCRIPTION_ID="<AZURE_SUBSCRIPTION_ID>"
export AZURE_RESOURCE_GROUP="<AZURE_RESOURCE_GROUP>"
export AZURE_LOCATION="<AZURE_LOCATION>"
export LAW_CUSTOMER_ID="<LOG_ANALYTICS_WORKSPACE_GUID>"
# ---- AWS (identity: aws sso login --profile) ----
export AWS_PROFILE="<AWS_PROFILE>"
export AWS_REGION="<AWS_REGION>"
# ---- Google Cloud (identity: gcloud auth login + application-default login) ----
export CLOUDSDK_CORE_PROJECT="<GCP_PROJECT_ID>"
export GCP_REGION="<GCP_REGION>"
export GCP_ZONE="<GCP_ZONE>"
# ---- Hyper-V ----
export HYPERV_SWITCH_NAME="<HYPERV_SWITCH_NAME>"
export HYPERV_VM_PATH="<HYPERV_VM_PATH>"
export LINUX_IMAGE_PATH="<LINUX_IMAGE_PATH>"
# ---- Arc onboarding (exported into each guest shell before onboard-arc.sh) ----
export ARC_SUBSCRIPTION_ID="$AZURE_SUBSCRIPTION_ID"; export ARC_TENANT_ID="$AZURE_TENANT_ID"
export ARC_RESOURCE_GROUP="$AZURE_RESOURCE_GROUP"; export ARC_LOCATION="$AZURE_LOCATION"
export ARC_OWNER="<OWNER>"; export ARC_COST_CENTER="<COST_CENTER>"; export ARC_EXPIRATION_DATE="<EXPIRATION_DATE>"
# ---- Optional AI layer (Entra ID token; no API key) ----
export FOUNDRY_ENDPOINT="<FOUNDRY_ENDPOINT>"        # e.g. https://<name>.openai.azure.com
export FOUNDRY_DEPLOYMENT="<MODEL_DEPLOYMENT_NAME>"
