// extension-inventory.kql : extensions installed on each Arc machine (AMA, CustomScript, etc.).
resources
| where type =~ 'microsoft.hybridcompute/machines/extensions'
// scope: whole subscription so every Arc-enabled server shows up; add back `| where resourceGroup =~ '<AZURE_RESOURCE_GROUP>'` to narrow
| extend machine = tostring(split(id, '/')[8]),
         extType = tostring(properties.type),
         publisher = tostring(properties.publisher),
         provisioningState = tostring(properties.provisioningState),
         extVersion = tostring(properties.typeHandlerVersion)
| project machine, name, extType, publisher, extVersion, provisioningState
| order by machine asc, name asc
